# Traffic Intelligence configuration
FLASK_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
TI_SECRET_KEY=replace-with-a-long-random-secret
MODEL_PATH=./models/yolov8n.pt
DATABASE_PATH=./database/traffic_analysis.db
UPLOAD_DIR=./backend/uploads
PROCESSED_DIR=./backend/processed
EVIDENCE_DIR=./backend/evidence
REPORTS_DIR=./backend/reports
LOG_DIR=./logs
MAX_UPLOAD_SIZE=524288000
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5000
CONFIDENCE_THRESHOLD=0.2
NMS_THRESHOLD=0.3
ALERT_SPEED_THRESHOLD=10
VIDEO_FPS=30
