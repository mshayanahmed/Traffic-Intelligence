# Traffic Intelligence configuration
FLASK_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
TI_SECRET_KEY=replace-with-a-long-random-secret
MODEL_PATH=./models/yolov8n.pt
DATABASE_PATH=./database/traffic_analysis.db
UPLOAD_DIR=./backend/uploads
PROCESSED_DIR=./backend/processed
EVIDENCE_DIR=./backend/evidence
REPORTS_DIR=./backend/reports
LOG_DIR=./logs
MAX_UPLOAD_SIZE=524288000
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5000
CONFIDENCE_THRESHOLD=0.2
NMS_THRESHOLD=0.3
ALERT_SPEED_THRESHOLD=10
VIDEO_FPS=30

# --- Authentication / admin bootstrap --------------------------------------
# Initial administrator (provisioned on first boot only; never hard-coded).
TI_ADMIN_EMAIL=admin@traffic-intelligence.com
TI_ADMIN_PASSWORD=          # set a strong password in the real environment
TI_ADMIN_EMAIL_DOMAIN=traffic-intelligence.com

# --- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty to disable email delivery (codes are then logged
# server-side only - fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Traffic Intelligence <no-reply@traffic-intelligence.com>
APP_URL=http://localhost:5000

# --- OTP tuning (optional) --------------------------------------------------
TI_OTP_TTL_SECONDS=600
TI_OTP_MAX_ATTEMPTS=5
TI_OTP_RESEND_COOLDOWN=60
TI_OTP_MAX_SENDS_PER_HOUR=5

